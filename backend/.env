# 医疗智能体系�?- 环境配置

# ==================== 应用配置 ====================
APP_NAME=医疗智能体系�?APP_VERSION=1.0.0
APP_DESCRIPTION=基于大语言模型的医疗智能体系统
DEBUG=True
SECRET_KEY=medical-ai-secret-key-2026

# ==================== 服务器配置?====================
HOST=0.0.0.0
PORT=8000

# ==================== 数据库配置?====================
DATABASE_URL=mysql+pymysql://root:123456@localhost:3306/medical_ai
DATABASE_ECHO=False
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ==================== Redis配置 ====================
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2

# ==================== 向量数据库配置?====================
VECTOR_DB_TYPE=chroma
CHROMA_PERSIST_DIR=./data/chroma_db

# ==================== JWT配置 ====================
JWT_SECRET_KEY=medical-ai-jwt-secret-key-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== 大语言模型配置 ====================
# 通义千问（阿里云百炼)
QIANWEN_API_KEY=sk-494459f8c0634b11a1b5e2ca6407b918
QIANWEN_MODEL=qwen-turbo
QIANWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# OpenAI GPT（备用）
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_BASE_URL=https://api.openai.com/v1

# ==================== 短信服务配置 ====================
SMS_PROVIDER=aliyun
SMS_ACCESS_KEY=your-sms-access-key
SMS_SECRET_KEY=your-sms-secret-key
SMS_SIGN_NAME=医疗智能�?SMS_TEMPLATE_CODE=SMS_xxxxx

# ==================== 邮件服务配置 ====================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@example.com

# ==================== 文件存储配置 ====================
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_OSS_BUCKET=your-oss-bucket
STORAGE_OSS_ENDPOINT=your-oss-endpoint

# ==================== CORS配置 ====================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/app.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5
